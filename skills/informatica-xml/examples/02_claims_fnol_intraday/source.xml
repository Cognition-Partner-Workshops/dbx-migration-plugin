<!DOCTYPE POWERMART SYSTEM "powrmart.dtd">
<POWERMART CREATION_DATE="09/02/2023 11:22:47" REPOSITORY_VERSION="187.96">
<REPOSITORY NAME="ALB_PROD_REPO" VERSION="187" CODEPAGE="Latin1" DATABASETYPE="Teradata">
<FOLDER NAME="INS_CLAIMS" GROUP="" OWNER="etl_admin" SHARED="NOTSHARED" DESCRIPTION="Claims loads - Guidewire CC + LEGACY_CLM (IMS)." PERMISSIONS="rwx---r--" UUID="2be6a911-4c02-47d0-9c31-8802cd11ea55">

    <MAPPING DESCRIPTION ="Intraday FNOL micro-batch: union Guidewire CC claim events with LEGACY_CLM extract; harmonise status + fraud flag; load CLAIMS_DB.CLAIM." ISVALID ="YES" NAME ="m_CLAIMS_FNOL_INTRADAY" OBJECTVERSION ="1" VERSIONNUMBER ="14">

        <TRANSFORMATION DESCRIPTION ="Loss date handling. ASSUMES GUIDEWIRE SENDS MM/DD/YYYY - it sends DD/MM/YYYY since the 2023 upgrade (INC0067812, open). Dates with day &lt;= 12 silently transpose; the BTEQ path (05_stg_claims_summary) treats the same field as DD/MM/YYYY. The two stores disagree for ~40% of claims." NAME ="EXP_CLAIM_DATES" OBJECTVERSION ="1" REUSABLE ="NO" TYPE ="Expression" VERSIONNUMBER ="7">
            <TRANSFORMFIELD DATATYPE ="string" EXPRESSION ="in_LOSS_DT_RAW" EXPRESSIONTYPE ="GENERAL" NAME ="in_LOSS_DT_RAW" PORTTYPE ="INPUT" PRECISION ="10" SCALE ="0"/>
            <TRANSFORMFIELD DATATYPE ="string" EXPRESSION ="in_SOURCE_SYSTEM" EXPRESSIONTYPE ="GENERAL" NAME ="in_SOURCE_SYSTEM" PORTTYPE ="INPUT" PRECISION ="12" SCALE ="0"/>
            <TRANSFORMFIELD DATATYPE ="date/time" EXPRESSION ="IIF(in_SOURCE_SYSTEM = 'GUIDEWIRE_CC', TO_DATE(in_LOSS_DT_RAW,'MM/DD/YYYY'), TO_DATE(in_LOSS_DT_RAW,'DD/MM/YYYY'))" EXPRESSIONTYPE ="GENERAL" NAME ="out_LOSS_DT" PORTTYPE ="OUTPUT" PRECISION ="29" SCALE ="9"/>
        </TRANSFORMATION>

        <TRANSFORMATION DESCRIPTION ="Fraud flag harmonisation. LEGACY_CLM 'S' (suspected) mapped to 'N' here -- the BTEQ staging maps the same 'S' to 'Y'. Fraud MI counts differ between the operational store and the analytical store as a result." NAME ="EXP_CLAIM_FLAGS" OBJECTVERSION ="1" REUSABLE ="NO" TYPE ="Expression" VERSIONNUMBER ="4">
            <TRANSFORMFIELD DATATYPE ="string" EXPRESSION ="in_FRAUD_IND" EXPRESSIONTYPE ="GENERAL" NAME ="in_FRAUD_IND" PORTTYPE ="INPUT" PRECISION ="1" SCALE ="0"/>
            <TRANSFORMFIELD DATATYPE ="string" EXPRESSION ="DECODE(in_FRAUD_IND, 'Y','Y', 'S','N', 'N','N', NULL)" EXPRESSIONTYPE ="GENERAL" NAME ="out_FRAUD_FLAG" PORTTYPE ="OUTPUT" PRECISION ="1" SCALE ="0"/>
        </TRANSFORMATION>

        <TRANSFORMATION DESCRIPTION ="Status harmonisation: LEGACY_CLM single-char O/S/R/D to Guidewire words." NAME ="EXP_CLAIM_STATUS" OBJECTVERSION ="1" REUSABLE ="NO" TYPE ="Expression" VERSIONNUMBER ="2">
            <TRANSFORMFIELD DATATYPE ="string" EXPRESSION ="in_STATUS_RAW" EXPRESSIONTYPE ="GENERAL" NAME ="in_STATUS_RAW" PORTTYPE ="INPUT" PRECISION ="8" SCALE ="0"/>
            <TRANSFORMFIELD DATATYPE ="string" EXPRESSION ="DECODE(in_STATUS_RAW, 'O','OPEN', 'S','CLOSED', 'R','REOPENED', 'D','DECLINED', in_STATUS_RAW)" EXPRESSIONTYPE ="GENERAL" NAME ="out_CLAIM_STATUS" PORTTYPE ="OUTPUT" PRECISION ="8" SCALE ="0"/>
        </TRANSFORMATION>

        <TRANSFORMATION DESCRIPTION ="Union of Guidewire and legacy claim pipes." NAME ="UN_CLAIM_SOURCES" OBJECTVERSION ="1" REUSABLE ="NO" TYPE ="Union Transformation" VERSIONNUMBER ="2"/>
    </MAPPING>

    <WORKFLOW DESCRIPTION ="Runs every 30 min 07:00-21:00. Control-M ALB-DWH-0047." ISENABLED ="YES" ISVALID ="YES" NAME ="wf_CLAIMS_FNOL_INTRADAY" REUSABLE_SCHEDULER ="NO" SCHEDULERNAME ="sched_30min" SERVERNAME ="ALB_INT_SVC" SERVER_DOMAINNAME ="Domain_ALB_PROD" SUSPEND_ON_ERROR ="NO" VERSIONNUMBER ="21">
        <TASK DESCRIPTION ="" NAME ="Start" REUSABLE ="NO" TYPE ="Start" VERSIONNUMBER ="1"/>
        <TASK DESCRIPTION ="" NAME ="s_m_CLAIMS_FNOL_INTRADAY" REUSABLE ="NO" TYPE ="Session" VERSIONNUMBER ="15">
            <ATTRIBUTE NAME ="Parameter Filename" VALUE ="/opt/informatica/parms/wf_CLAIMS_FNOL_INTRADAY.par"/>
        </TASK>
        <WORKFLOWLINK CONDITION ="" FROMTASK ="Start" TOTASK ="s_m_CLAIMS_FNOL_INTRADAY"/>
    </WORKFLOW>
</FOLDER>
</REPOSITORY>
