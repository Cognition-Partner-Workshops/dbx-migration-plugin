[
  {"rule": "empty_string_is_null", "applies_to": "VARCHAR2,NVARCHAR2,CHAR,NCHAR,CLOB->STRING", "params": {"policy": "SET_AT_STOP_A", "default": "treat_empty_as_null"}},
  {"rule": "decimal_round", "applies_to": "NUMBER,NUMBER(p,s),FLOAT,BINARY_FLOAT,BINARY_DOUBLE->DECIMAL(38,10),DECIMAL(p,s),DOUBLE", "params": {"mode": "half_even", "places": 10}},
  {"rule": "datetime_utc_truncate_ms", "applies_to": "DATE,TIMESTAMP,TIMESTAMP WITH TIME ZONE,TIMESTAMP WITH LOCAL TIME ZONE->TIMESTAMP_NTZ,TIMESTAMP", "params": {"assume_source_tz_for_DATE": "DBTIMEZONE"}},
  {"rule": "rstrip_spaces", "applies_to": "CHAR,NCHAR->STRING", "params": {}},
  {"rule": "null_missing_equiv", "applies_to": "*", "params": {}},
  {"rule": "collation_casefold", "applies_to": "STRING", "params": {"enabled_if": "NLS_COMP=LINGUISTIC or UPPER()/NLS_UPPER() compares found in census"}},
  {"rule": "uuid_normalize", "applies_to": "RAW(16)->STRING", "params": {"enabled_if": "SYS_GUID() default or RAWTOHEX consumers found in census"}},
  {"rule": "identity", "applies_to": "*", "params": {}}
]
