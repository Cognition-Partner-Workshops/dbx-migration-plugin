{
  "routines": [
    {
      "routine": "app_pkg.close_period",
      "reads": ["app.period", "app.ledger_entry"],
      "writes": ["app.ledger_balance"],
      "calls": ["app_pkg.write_run_log", "app_pkg.archive_entries"]
    },
    {
      "routine": "app_pkg.archive_entries",
      "reads": ["app.ledger_entry"],
      "writes": ["app.ledger_entry_hist", "app.ledger_entry"],
      "calls": ["app_pkg.write_run_log"]
    },
    {
      "routine": "app_pkg.write_run_log",
      "reads": [],
      "writes": ["app.run_log"],
      "calls": []
    },
    {
      "routine": "app_pkg.period_status",
      "reads": ["app.period"],
      "writes": [],
      "calls": []
    }
  ]
}
