/* Source: uc-dw-migration-teradata-to-bigquery dml/scripts/bteq_daily_load.btq (verbatim) */
/*********************************************************************
 * BTEQ Daily Load Script
 * Orchestrates the daily ETL pipeline for the banking data warehouse
 * Uses Teradata BTEQ commands (.LOGON, .IF, .QUIT, .EXPORT, etc.)
 *********************************************************************/

.LOGON TDPROD/etl_svc_acct,;

.SET WIDTH 200;
.SET SEPARATOR '|';
.SET TITLEDASHES OFF;

DATABASE BANKING_DW;

/* ================================================================
   Step 1: Validate staging data
   ================================================================ */
SEL 'STAGING_CHECK' AS STEP_NAME,
     COUNT(*) AS ROW_COUNT,
     MIN(LOAD_DATE) (FORMAT 'YYYY-MM-DD') AS MIN_DATE,
     MAX(LOAD_DATE) (FORMAT 'YYYY-MM-DD') AS MAX_DATE,
     COUNT(DISTINCT ACCOUNT_ID) AS DISTINCT_ACCOUNTS
FROM BANKING_DW.STG_TRANSACTIONS
WHERE LOAD_DATE = CURRENT_DATE;

.IF ACTIVITYCOUNT = 0 THEN .GOTO NOSTAGING;

/* ================================================================
   Step 2: Generate new batch ID
   ================================================================ */
SEL MAX(BATCH_ID) + 1 AS NEW_BATCH_ID
FROM BANKING_DW.ETL_BATCH_CONTROL;

.IF ERRORCODE <> 0 THEN .GOTO ERRORHANDLER;

/* Store the batch ID in a volatile table for later use */
CREATE VOLATILE TABLE VT_BATCH AS (
    SEL MAX(BATCH_ID) + 1 AS BATCH_ID,
         CURRENT_DATE AS BATCH_DATE,
         CURRENT_TIMESTAMP(0) AS BATCH_START_TS
    FROM BANKING_DW.ETL_BATCH_CONTROL
) WITH DATA ON COMMIT PRESERVE ROWS;

/* ================================================================
   Step 3: Run SCD2 customer dimension update
   ================================================================ */
CALL BANKING_DW.SP_CUSTOMER_SCD2(
    (SEL BATCH_ID FROM VT_BATCH),
    new_rows,
    changed_rows,
    return_code
);

.IF ERRORCODE <> 0 THEN .GOTO ERRORHANDLER;

/* ================================================================
   Step 4: Load daily transactions
   ================================================================ */
CALL BANKING_DW.SP_LOAD_DAILY_TRANSACTIONS(
    CURRENT_DATE,
    (SEL BATCH_ID FROM VT_BATCH),
    rows_inserted,
    rows_rejected,
    return_code
);

.IF ERRORCODE <> 0 THEN .GOTO ERRORHANDLER;

/* ================================================================
   Step 5: Run balance reconciliation
   ================================================================ */
EXEC BANKING_DW.DAILY_BALANCE_CHECK(CURRENT_DATE);

/* ================================================================
   Step 6: Export reconciliation report
   ================================================================ */
.EXPORT REPORT FILE=/etl/reports/daily_recon_YYYYMMDD.txt;

SEL
    'DAILY_RECONCILIATION' AS REPORT_TYPE,
    CURRENT_DATE (FORMAT 'YYYY-MM-DD') AS REPORT_DATE,
    (SEL BATCH_ID FROM VT_BATCH) AS BATCH_ID,
    (SEL COUNT(*) FROM BANKING_DW.STG_TRANSACTIONS
     WHERE LOAD_DATE = CURRENT_DATE) AS STAGED_ROWS,
    (SEL COUNT(*) FROM BANKING_DW.FACT_TRANSACTION
     WHERE ETL_BATCH_ID = (SEL BATCH_ID FROM VT_BATCH)) AS LOADED_ROWS,
    (SEL COUNT(*) FROM BANKING_DW.STG_TRANSACTION_ERRORS
     WHERE BATCH_ID = (SEL BATCH_ID FROM VT_BATCH)) AS ERROR_ROWS;

.EXPORT RESET;

/* ================================================================
   Step 7: Record batch completion
   ================================================================ */
INSERT INTO BANKING_DW.ETL_BATCH_CONTROL (
    BATCH_ID, BATCH_DATE, BATCH_STATUS, START_TS, END_TS
)
SEL BATCH_ID, BATCH_DATE, 'COMPLETED', BATCH_START_TS, CURRENT_TIMESTAMP(0)
FROM VT_BATCH;

DROP TABLE VT_BATCH;

.QUIT 0;

/* ================================================================
   Error Handlers
   ================================================================ */
.LABEL NOSTAGING;
SEL 'WARNING: No staging data found for ' || TRIM(CURRENT_DATE (FORMAT 'YYYY-MM-DD'));
.QUIT 4;

.LABEL ERRORHANDLER;
SEL 'ERROR: ETL pipeline failed. ERRORCODE=' || TRIM(ERRORCODE (FORMAT '-9(5)'));

INSERT INTO BANKING_DW.ETL_BATCH_CONTROL (
    BATCH_ID, BATCH_DATE, BATCH_STATUS, START_TS, END_TS
)
SEL BATCH_ID, BATCH_DATE, 'FAILED', BATCH_START_TS, CURRENT_TIMESTAMP(0)
FROM VT_BATCH;

.QUIT 8;
