/* Skill-authored minimal fixture: MultiLoad (MLOAD) upsert of the FX rate feed into BANKING_DW.DIM_EXCHANGE_RATES
   (the table SP_LOAD_DAILY_TRANSACTIONS joins for BASE_CURRENCY_AMOUNT). Exercises: .LOGTABLE, .BEGIN IMPORT MLOAD
   with WORKTABLES/ERRORTABLES/ERRLIMIT, .LAYOUT with .FIELD/.FILLER, .DML LABEL with DO INSERT FOR MISSING UPDATE ROWS
   (UPSERT), .IMPORT INFILE ... APPLY, .END MLOAD, .LOGOFF. */

.LOGTABLE BANKING_DW.ML_FX_RATES_LOG;
.LOGON $tdpid/$user,$password;         /* substituted by the scheduler wrapper; never inline */

.BEGIN IMPORT MLOAD
    TABLES      BANKING_DW.DIM_EXCHANGE_RATES
    WORKTABLES  BANKING_DW.WT_FX_RATES
    ERRORTABLES BANKING_DW.ET_FX_RATES
                BANKING_DW.UV_FX_RATES
    ERRLIMIT    100
    CHECKPOINT  50000
    SESSIONS    4;

.LAYOUT FX_LAYOUT;
    .FIELD  FROM_CURRENCY   *  CHAR(3);
    .FIELD  TO_CURRENCY     *  CHAR(3);
    .FIELD  RATE_DATE       *  CHAR(10);
    .FIELD  EXCHANGE_RATE   *  CHAR(18);
    .FILLER SOURCE_SYSTEM   *  CHAR(10);          /* present in the feed, not loaded */
    .FIELD  RATE_SOURCE     *  CHAR(20);

.DML LABEL UPSERT_FX
    DO INSERT FOR MISSING UPDATE ROWS;
    UPDATE BANKING_DW.DIM_EXCHANGE_RATES
       SET EXCHANGE_RATE  = :EXCHANGE_RATE (DECIMAL(18,8)),
           RATE_SOURCE    = :RATE_SOURCE,
           ETL_UPDATE_TS  = CURRENT_TIMESTAMP(0)
     WHERE FROM_CURRENCY = :FROM_CURRENCY
       AND TO_CURRENCY   = :TO_CURRENCY
       AND RATE_DATE     = :RATE_DATE (DATE, FORMAT 'YYYY-MM-DD');
    INSERT INTO BANKING_DW.DIM_EXCHANGE_RATES
        (FROM_CURRENCY, TO_CURRENCY, RATE_DATE, EXCHANGE_RATE, RATE_SOURCE, ETL_INSERT_TS, ETL_UPDATE_TS)
    VALUES
        (:FROM_CURRENCY, :TO_CURRENCY, :RATE_DATE (DATE, FORMAT 'YYYY-MM-DD'),
         :EXCHANGE_RATE (DECIMAL(18,8)), :RATE_SOURCE, CURRENT_TIMESTAMP(0), CURRENT_TIMESTAMP(0));

.IMPORT INFILE /etl/landing/fx/fx_rates_daily.txt
    FORMAT VARTEXT '|'
    LAYOUT FX_LAYOUT
    APPLY UPSERT_FX;

.END MLOAD;
.LOGOFF;
