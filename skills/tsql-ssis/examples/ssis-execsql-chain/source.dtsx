<?xml version="1.0"?>
<!--
  Representative .dtsx-shaped fixture (hand-written) for the tsql-ssis skill.

  Package: NightlyServicing.dtsx  (SQL Server edition of batch/run_nightly_batch.sh)
  Shape:   four Execute SQL Tasks + one notification task, wired with precedence constraints:

     [SQL Count eligible]  (ResultSet=SingleRow -> User::EligibleCount)
            |  Success AND expression  @[User::EligibleCount] > 0
            v
     [SQL Nightly accrual]  =Success=>  [SQL Apply late fees]  =Success=>  [SQL EOD reconciliation]
            |                                   |                                      |
            +========== Failure (LogicalOr) ====+============= Failure ================+
                                                v
                                     [SQL Log failure]   (Completion constraint to nothing; package fails
                                                          because FailPackageOnFailure=True on the three steps)

  OnError event handler at package scope inserts into dbo.audit_trail.
-->
<DTS:Executable xmlns:DTS="www.microsoft.com/SqlServer/Dts"
  DTS:ExecutableType="Microsoft.Package"
  DTS:ObjectName="NightlyServicing"
  DTS:MaxErrorCount="1"
  DTS:ProtectionLevel="EncryptSensitiveWithUserKey">

  <DTS:ConnectionManagers>
    <DTS:ConnectionManager DTS:ObjectName="OLTP_LoanServicing" DTS:CreationName="OLEDB">
      <DTS:ObjectData>
        <DTS:ConnectionManager
          DTS:ConnectionString="Data Source=@[$Project::ServerName];Initial Catalog=loan_servicing;Provider=SQLNCLI11;Integrated Security=SSPI;" />
      </DTS:ObjectData>
    </DTS:ConnectionManager>
  </DTS:ConnectionManagers>

  <DTS:Variables>
    <DTS:Variable DTS:Namespace="User" DTS:ObjectName="EligibleCount" DTS:DataType="3">
      <DTS:VariableValue DTS:DataType="3">0</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable DTS:Namespace="User" DTS:ObjectName="ProcessingDate" DTS:DataType="7"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="(DT_DBDATE)GETDATE()" />
  </DTS:Variables>

  <!-- Project parameter referenced above; lives in Project.params in a real project -->
  <DTS:PackageParameters>
    <DTS:PackageParameter DTS:ObjectName="ServerName" DTS:DataType="8" DTS:Required="True" />
    <DTS:PackageParameter DTS:ObjectName="ServicerId" DTS:DataType="3">
      <DTS:Property DTS:Name="ParameterValue">7</DTS:Property>
    </DTS:PackageParameter>
  </DTS:PackageParameters>

  <DTS:Executables>

    <DTS:Executable DTS:refId="Package\SQL Count eligible" DTS:ObjectName="SQL Count eligible"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask"
          SQLTask:Connection="Package.ConnectionManagers[OLTP_LoanServicing]"
          SQLTask:ResultType="ResultSetType_SingleRow"
          SQLTask:SqlStatementSource="SELECT COUNT(*) AS n FROM dbo.loans WHERE loan_status = 'AC' AND servicer_id = ?">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="$Package::ServicerId" SQLTask:ParameterDirection="Input" />
          <SQLTask:ResultBinding SQLTask:ResultName="n" SQLTask:DtsVariableName="User::EligibleCount" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>

    <DTS:Executable DTS:refId="Package\SQL Nightly accrual" DTS:ObjectName="SQL Nightly accrual"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:FailPackageOnFailure="True">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask"
          SQLTask:Connection="Package.ConnectionManagers[OLTP_LoanServicing]"
          SQLTask:SqlStatementSource="EXEC dbo.sp_nightly_accrual @processing_date = ?">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::ProcessingDate" SQLTask:ParameterDirection="Input" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>

    <DTS:Executable DTS:refId="Package\SQL Apply late fees" DTS:ObjectName="SQL Apply late fees"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:FailPackageOnFailure="True">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask"
          SQLTask:Connection="Package.ConnectionManagers[OLTP_LoanServicing]"
          SQLTask:SqlStatementSource="EXEC dbo.sp_apply_late_fees @cutoff_date = ?">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::ProcessingDate" SQLTask:ParameterDirection="Input" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>

    <DTS:Executable DTS:refId="Package\SQL EOD reconciliation" DTS:ObjectName="SQL EOD reconciliation"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask" DTS:FailPackageOnFailure="True">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask"
          SQLTask:Connection="Package.ConnectionManagers[OLTP_LoanServicing]"
          SQLTask:SqlStatementSource="EXEC dbo.sp_end_of_day_reconciliation" />
      </DTS:ObjectData>
    </DTS:Executable>

    <DTS:Executable DTS:refId="Package\SQL Log failure" DTS:ObjectName="SQL Log failure"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask">
      <DTS:ObjectData>
        <SQLTask:SqlTaskData xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask"
          SQLTask:Connection="Package.ConnectionManagers[OLTP_LoanServicing]"
          SQLTask:SqlStatementSource="INSERT INTO dbo.audit_trail (action_type, action_date, table_name, record_count, new_value) VALUES ('BATCH_FAILED', GETDATE(), 'loans', ?, 'NightlyServicing.dtsx')">
          <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="User::EligibleCount" SQLTask:ParameterDirection="Input" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>

  </DTS:Executables>

  <DTS:PrecedenceConstraints>
    <!-- Count -> Accrual: Success AND expression -->
    <DTS:PrecedenceConstraint DTS:ObjectName="Count to Accrual"
      DTS:From="Package\SQL Count eligible" DTS:To="Package\SQL Nightly accrual"
      DTS:Value="0" DTS:EvalOp="3" DTS:LogicalAnd="True"
      DTS:Expression="@[User::EligibleCount] &gt; 0" />
      <!-- DTS:Value 0=Success 1=Failure 2=Completion; EvalOp 1=Constraint 2=Expression 3=ExpressionAndConstraint 4=ExpressionOrConstraint -->

    <DTS:PrecedenceConstraint DTS:ObjectName="Accrual to Fees"
      DTS:From="Package\SQL Nightly accrual" DTS:To="Package\SQL Apply late fees"
      DTS:Value="0" DTS:EvalOp="1" DTS:LogicalAnd="True" />

    <DTS:PrecedenceConstraint DTS:ObjectName="Fees to EOD"
      DTS:From="Package\SQL Apply late fees" DTS:To="Package\SQL EOD reconciliation"
      DTS:Value="0" DTS:EvalOp="1" DTS:LogicalAnd="True" />

    <!-- Any failure -> Log failure. LogicalAnd="False" == LogicalOr: fire when ANY incoming constraint is met -->
    <DTS:PrecedenceConstraint DTS:ObjectName="Accrual failed"
      DTS:From="Package\SQL Nightly accrual" DTS:To="Package\SQL Log failure"
      DTS:Value="1" DTS:EvalOp="1" DTS:LogicalAnd="False" />
    <DTS:PrecedenceConstraint DTS:ObjectName="Fees failed"
      DTS:From="Package\SQL Apply late fees" DTS:To="Package\SQL Log failure"
      DTS:Value="1" DTS:EvalOp="1" DTS:LogicalAnd="False" />
    <DTS:PrecedenceConstraint DTS:ObjectName="EOD failed"
      DTS:From="Package\SQL EOD reconciliation" DTS:To="Package\SQL Log failure"
      DTS:Value="1" DTS:EvalOp="1" DTS:LogicalAnd="False" />
  </DTS:PrecedenceConstraints>

  <DTS:EventHandlers>
    <DTS:EventHandler DTS:EventName="OnError">
      <DTS:Executables>
        <DTS:Executable DTS:ObjectName="SQL OnError audit" DTS:ExecutableType="Microsoft.ExecuteSQLTask">
          <DTS:ObjectData>
            <SQLTask:SqlTaskData xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask"
              SQLTask:Connection="Package.ConnectionManagers[OLTP_LoanServicing]"
              SQLTask:SqlStatementSource="INSERT INTO dbo.audit_trail (action_type, action_date, table_name, new_value) VALUES ('SSIS_ONERROR', GETDATE(), ?, ?)">
              <SQLTask:ParameterBinding SQLTask:ParameterName="0" SQLTask:DtsVariableName="System::SourceName" SQLTask:ParameterDirection="Input" />
              <SQLTask:ParameterBinding SQLTask:ParameterName="1" SQLTask:DtsVariableName="System::ErrorDescription" SQLTask:ParameterDirection="Input" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
    </DTS:EventHandler>
  </DTS:EventHandlers>
</DTS:Executable>
