{
  "routines": [
    {
      "routine": "app_pkg.close_period",
      "reads": [
        "app.period",
        "app.acct_entry"
      ],
      "writes": [
        "app.acct_balance"
      ],
      "calls": [
        "app_pkg.write_run_log"
      ]
    },
    {
      "routine": "app_pkg.archive_entries",
      "reads": [
        "app.acct_entry"
      ],
      "writes": [
        "app.acct_entry_hist",
        "app.acct_entry"
      ],
      "calls": [
        "app_pkg.write_run_log"
      ]
    },
    {
      "routine": "app_pkg.write_run_log",
      "reads": [],
      "writes": [
        "app.run_log"
      ],
      "calls": []
    },
    {
      "routine": "app_pkg.period_status",
      "reads": [
        "app.period"
      ],
      "writes": [],
      "calls": []
    }
  ]
}
