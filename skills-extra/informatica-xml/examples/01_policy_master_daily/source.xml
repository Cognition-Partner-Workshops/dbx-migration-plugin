        </TASK>
        <WORKFLOWLINK CONDITION ="" FROMTASK ="Start" TOTASK ="ew_WAIT_PLCYMSTR"/>
        <WORKFLOWLINK CONDITION ="" FROMTASK ="ew_WAIT_PLCYMSTR" TOTASK ="s_m_POLICY_MASTER_DAILY"/>
