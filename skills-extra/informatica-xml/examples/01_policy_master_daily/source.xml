    <MAPPING DESCRIPTION ="Load LEGACY_PAS policy master into Teradata staging. Julian date conversion, postcode standardisation (DQR-014 variant A), client->party crosswalk lookup, UW-definition active flag." ISVALID ="YES" NAME ="m_POLICY_MASTER_DAILY" OBJECTVERSION ="1" VERSIONNUMBER ="9">
        <TRANSFORMATION DESCRIPTION ="Julian YYDDD to DATE. Y2K window: 00-49 => 20xx (NB actuarial SAS macro uses 00-50)." NAME ="EXP_POLICY_DATES" OBJECTVERSION ="1" REUSABLE ="NO" TYPE ="Expression" VERSIONNUMBER ="3">
            <TRANSFORMFIELD DATATYPE ="string" DEFAULTVALUE ="" DESCRIPTION ="" EXPRESSION ="PLCY_INCEPT_DT_JUL" EXPRESSIONTYPE ="GENERAL" NAME ="in_JULIAN" PICTURETEXT ="" PORTTYPE ="INPUT" PRECISION ="5" SCALE ="0"/>
            <TRANSFORMFIELD DATATYPE ="integer" DEFAULTVALUE ="" DESCRIPTION ="Y2K windowed year" EXPRESSION ="IIF(TO_INTEGER(SUBSTR(in_JULIAN,1,2)) &lt;= 49, 2000 + TO_INTEGER(SUBSTR(in_JULIAN,1,2)), 1900 + TO_INTEGER(SUBSTR(in_JULIAN,1,2)))" EXPRESSIONTYPE ="GENERAL" NAME ="v_YEAR" PICTURETEXT ="" PORTTYPE ="LOCAL VARIABLE" PRECISION ="10" SCALE ="0"/>
            <TRANSFORMFIELD DATATYPE ="date/time" DEFAULTVALUE ="" DESCRIPTION ="" EXPRESSION ="ADD_TO_DATE(TO_DATE(TO_CHAR(v_YEAR)||'0101','YYYYMMDD'),'DD',TO_INTEGER(SUBSTR(in_JULIAN,3,3)) - 1)" EXPRESSIONTYPE ="GENERAL" NAME ="out_INCEPTION_DT" PICTURETEXT ="" PORTTYPE ="OUTPUT" PRECISION ="29" SCALE ="9"/>
        </TRANSFORMATION>
        <TRANSFORMATION DESCRIPTION ="Postcode standardise + validate. DQR-014 variant A: repairs a missing space (inserts before final 3 chars), then validates with REG_MATCH. More permissive than BTEQ variant (requires space) and SAS variant (case sensitive)." NAME ="EXP_POSTCODE_DQ" OBJECTVERSION ="1" REUSABLE ="NO" TYPE ="Expression" VERSIONNUMBER ="5">
            <TRANSFORMFIELD DATATYPE ="string" DEFAULTVALUE ="" DESCRIPTION ="" EXPRESSION ="PLCY_POSTCODE" EXPRESSIONTYPE ="GENERAL" NAME ="in_POSTCODE" PICTURETEXT ="" PORTTYPE ="INPUT" PRECISION ="8" SCALE ="0"/>
            <TRANSFORMFIELD DATATYPE ="string" DEFAULTVALUE ="" DESCRIPTION ="Insert space before final 3 chars if absent" EXPRESSION ="IIF(INSTR(LTRIM(RTRIM(in_POSTCODE)),' ') = 0 AND LENGTH(LTRIM(RTRIM(in_POSTCODE))) &gt;= 5, SUBSTR(LTRIM(RTRIM(in_POSTCODE)),1,LENGTH(LTRIM(RTRIM(in_POSTCODE)))-3) || ' ' || SUBSTR(LTRIM(RTRIM(in_POSTCODE)),LENGTH(LTRIM(RTRIM(in_POSTCODE)))-2,3), UPPER(LTRIM(RTRIM(in_POSTCODE))))" EXPRESSIONTYPE ="GENERAL" NAME ="v_PC_STD" PICTURETEXT ="" PORTTYPE ="LOCAL VARIABLE" PRECISION ="10" SCALE ="0"/>
            <TRANSFORMFIELD DATATYPE ="string" DEFAULTVALUE ="" DESCRIPTION ="" EXPRESSION ="UPPER(v_PC_STD)" EXPRESSIONTYPE ="GENERAL" NAME ="out_POSTCODE_STD" PICTURETEXT ="" PORTTYPE ="OUTPUT" PRECISION ="10" SCALE ="0"/>
            <TRANSFORMFIELD DATATYPE ="string" DEFAULTVALUE ="" DESCRIPTION ="DQR-014" EXPRESSION ="IIF(REG_MATCH(UPPER(v_PC_STD),'^[A-Z]{1,2}[0-9][A-Z0-9]? [0-9][A-Z]{2}$'),'VALID','INVALID')" EXPRESSIONTYPE ="GENERAL" NAME ="out_POSTCODE_DQ_STATUS" PICTURETEXT ="" PORTTYPE ="OUTPUT" PRECISION ="7" SCALE ="0"/>
        </TRANSFORMATION>
        <TRANSFORMATION DESCRIPTION ="Active flag per UNDERWRITING definition: status IF or RN. Finance disagree (see 04_stg_policy_360.bteq)." NAME ="EXP_POLICY_FLAGS" OBJECTVERSION ="1" REUSABLE ="NO" TYPE ="Expression" VERSIONNUMBER ="2">
            <TRANSFORMFIELD DATATYPE ="string" DEFAULTVALUE ="" DESCRIPTION ="" EXPRESSION ="PLCY_STATUS" EXPRESSIONTYPE ="GENERAL" NAME ="in_STATUS" PICTURETEXT ="" PORTTYPE ="INPUT" PRECISION ="2" SCALE ="0"/>
            <TRANSFORMFIELD DATATYPE ="string" DEFAULTVALUE ="" DESCRIPTION ="" EXPRESSION ="IIF(in_STATUS = 'IF' OR in_STATUS = 'RN','Y','N')" EXPRESSIONTYPE ="GENERAL" NAME ="out_ACTIVE_POLICY_FLAG" PICTURETEXT ="" PORTTYPE ="OUTPUT" PRECISION ="1" SCALE ="0"/>
        </TRANSFORMATION>
        <TRANSFORMATION DESCRIPTION ="Crosswalk LEGACY_PAS CLIENT_NO to POLARIS PARTY_ID via manually maintained REF_DB.XREF_CLIENT_PARTY. Unmatched rows pass through with NULL PARTY_ID (approx 12% daily)." NAME ="LKP_XREF_CLIENT_PARTY" OBJECTVERSION ="1" REUSABLE ="YES" TYPE ="Lookup Procedure" VERSIONNUMBER ="2">
            <TRANSFORMFIELD DATATYPE ="decimal" DEFAULTVALUE ="" DESCRIPTION ="" NAME ="CLIENT_NO" PORTTYPE ="INPUT/OUTPUT" PRECISION ="10" SCALE ="0"/>
            <TRANSFORMFIELD DATATYPE ="string" DEFAULTVALUE ="" DESCRIPTION ="" NAME ="PARTY_ID" PORTTYPE ="LOOKUP/OUTPUT" PRECISION ="8" SCALE ="0"/>
            <TABLEATTRIBUTE NAME ="Lookup table name" VALUE ="REF_DB.XREF_CLIENT_PARTY"/>
            <TABLEATTRIBUTE NAME ="Lookup caching enabled" VALUE ="YES"/>
            <TABLEATTRIBUTE NAME ="Lookup policy on multiple match" VALUE ="Use First Value"/>
        </TRANSFORMATION>
        <!-- INSTANCE rows elided: SQ_PLCYMSTR_DAILY (Source Qualifier), the four transformations above, STG_POLICY_MASTER (TARGET) -->
        <CONNECTOR FROMFIELD ="PLCY_INCEPT_DT_JUL" FROMINSTANCE ="SQ_PLCYMSTR_DAILY" FROMINSTANCETYPE ="Source Qualifier" TOFIELD ="in_JULIAN" TOINSTANCE ="EXP_POLICY_DATES" TOINSTANCETYPE ="Expression"/>
        <CONNECTOR FROMFIELD ="PLCY_POSTCODE" FROMINSTANCE ="SQ_PLCYMSTR_DAILY" FROMINSTANCETYPE ="Source Qualifier" TOFIELD ="in_POSTCODE" TOINSTANCE ="EXP_POSTCODE_DQ" TOINSTANCETYPE ="Expression"/>
        <CONNECTOR FROMFIELD ="PLCY_STATUS" FROMINSTANCE ="SQ_PLCYMSTR_DAILY" FROMINSTANCETYPE ="Source Qualifier" TOFIELD ="in_STATUS" TOINSTANCE ="EXP_POLICY_FLAGS" TOINSTANCETYPE ="Expression"/>
        <CONNECTOR FROMFIELD ="PLCY_CLIENT_NO" FROMINSTANCE ="SQ_PLCYMSTR_DAILY" FROMINSTANCETYPE ="Source Qualifier" TOFIELD ="CLIENT_NO" TOINSTANCE ="LKP_XREF_CLIENT_PARTY" TOINSTANCETYPE ="Lookup Procedure"/>
        <CONNECTOR FROMFIELD ="out_INCEPTION_DT" FROMINSTANCE ="EXP_POLICY_DATES" FROMINSTANCETYPE ="Expression" TOFIELD ="INCEPTION_DT" TOINSTANCE ="STG_POLICY_MASTER" TOINSTANCETYPE ="Target Definition"/>
        <CONNECTOR FROMFIELD ="out_POSTCODE_STD" FROMINSTANCE ="EXP_POSTCODE_DQ" FROMINSTANCETYPE ="Expression" TOFIELD ="POSTCODE_STD" TOINSTANCE ="STG_POLICY_MASTER" TOINSTANCETYPE ="Target Definition"/>
        <CONNECTOR FROMFIELD ="out_POSTCODE_DQ_STATUS" FROMINSTANCE ="EXP_POSTCODE_DQ" FROMINSTANCETYPE ="Expression" TOFIELD ="POSTCODE_DQ_STATUS" TOINSTANCE ="STG_POLICY_MASTER" TOINSTANCETYPE ="Target Definition"/>
        <CONNECTOR FROMFIELD ="out_ACTIVE_POLICY_FLAG" FROMINSTANCE ="EXP_POLICY_FLAGS" FROMINSTANCETYPE ="Expression" TOFIELD ="ACTIVE_POLICY_FLAG" TOINSTANCE ="STG_POLICY_MASTER" TOINSTANCETYPE ="Target Definition"/>
        <CONNECTOR FROMFIELD ="PARTY_ID" FROMINSTANCE ="LKP_XREF_CLIENT_PARTY" FROMINSTANCETYPE ="Lookup Procedure" TOFIELD ="PARTY_ID" TOINSTANCE ="STG_POLICY_MASTER" TOINSTANCETYPE ="Target Definition"/>
        <!-- No CONNECTOR feeds ANNUAL_PREMIUM_GBP: the 9(09)V99 scaling is INFERRED in converted.py -->
    </MAPPING>

