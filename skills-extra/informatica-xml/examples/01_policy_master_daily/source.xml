        <TARGETFIELD BUSINESSNAME ="" DATATYPE ="varchar" FIELDNUMBER ="8" KEYTYPE ="NOT A KEY" NAME ="POSTCODE_STD" NULLABLE ="NULL" PICTURETEXT ="" PRECISION ="10" SCALE ="0"/>
        <TARGETFIELD BUSINESSNAME ="" DATATYPE ="varchar" FIELDNUMBER ="9" KEYTYPE ="NOT A KEY" NAME ="POSTCODE_DQ_STATUS" NULLABLE ="NULL" PICTURETEXT ="" PRECISION ="7" SCALE ="0"/>
