{
  "PreToolUse": [
    {
      "matcher": "exec",
      "hooks": [
        {
          "type": "command",
          "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\"",
          "timeout": 10
        }
      ]
    },
    {
      "matcher": "^(edit|write|MultiEdit)$",
      "hooks": [
        {
          "type": "command",
          "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\"",
          "timeout": 10
        }
      ]
    }
  ]
}
